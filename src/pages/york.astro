---
import Layout from '../layouts/Layout.astro';
import YorkLocationHub from '../components/pages/YorkLocationHub';
---

<Layout 
  title="Driving Lessons Across York | All Areas & Postcodes"
  description="Find driving lessons in your part of York. We cover Acomb, Clifton, Heworth, Haxby, Rawcliffe, Fulford and more — choose your area to get started."
>
  <YorkLocationHub client:load />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "DrivingSchool",
      "name": "York Driving Lesson",
      "url": "https://yorkdrivinglesson.co.uk",
      "image": "https://yorkdrivinglesson.co.uk/images/logo.png",
      "description": "DVSA-approved driving school covering all areas of York — Acomb, Clifton, Heworth, Fulford, Haxby, Rawcliffe, and more.",
      "telephone": "+447763999317",
      "email": "support@yorkdrivinglesson.co.uk",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Unit 2, Arabesque House, Monks Cross Drive",
        "addressLocality": "York",
        "addressRegion": "North Yorkshire",
        "postalCode": "YO32 9GW",
        "addressCountry": "GB"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 53.988,
        "longitude": -1.0647
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
          "opens": "00:00",
          "closes": "23:59"
        }
      ],
      "areaServed": {
        "@type": "City",
        "name": "York"
      },
      "priceRange": "££"
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://yorkdrivinglesson.co.uk/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Driving Lesson Areas Across York",
          "item": "https://yorkdrivinglesson.co.uk/york/"
        }
      ]
    }
  </script>
</Layout>
