---
import Layout from '../layouts/Layout.astro';
import LocationTemplate from '../components/PageTemplates/LocationTemplate';

const faqs = [
  { 
    question: "Where do we start driving lessons in Wigginton?", 
    answer: "We can start from your home in Wigginton or a convenient local spot. Beginners often start in the quieter residential loops off Mill Lane to build basic confidence during your <a href='/manual-driving-lessons' class='font-bold underline'>driving lessons in York</a>." 
  },
  { 
    question: "How do you help learners with the transition between Wigginton and Haxby?", 
    answer: "The two villages are closely linked. We'll practise navigating the residential connections and smaller roundabouts that join <a href='/driving-lessons-haxby-york' class='font-bold underline'>Haxby</a>, ideal for building solid priority habits."
  },
  { 
    question: "Can we practise for the York outer ring road in Wigginton?",
    answer: "Yes, Wigginton Road offers several approaches to the A1237. We'll help you gain confidence with merging, lane positioning, and understanding multi-lane roundabout exits safely near the <a href='/monks-cross-driving-test-centre' class='font-bold underline'>Monks Cross Driving Test Centre</a>."
  },
  {
    question: "Do you offer automatic driving lessons in YO32?", 
    answer: "Absolutely. We provide <a href='/automatic-driving-lessons' class='font-bold underline'>automatic driving lessons in York</a> throughout Wigginton and the wider YO32 postcode, making it easier to focus on navigation."
  },
  { 
    question: "Is Wigginton a good area for absolute beginners?", 
