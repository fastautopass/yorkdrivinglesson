---
import Layout from '../layouts/Layout.astro';
import AboutUs from '../components/pages/AboutUs';
---

<Layout
  title="About York Driving Lesson | DVSA-Approved York School"
  description="York Driving Lesson is a DVSA-approved driving school in York. Find out how we teach, and why learners across York trust us to get them on the road. Book today."
>
  <AboutUs client:load />

  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "DrivingSchool",
      "name": "York Driving Lesson",
      "url": "https://yorkdrivinglesson.co.uk",
      "image": "https://yorkdrivinglesson.co.uk/images/logo.png",
      "description": "DVSA-approved driving school in York. Manual, automatic, intensive, refresher, mock tests, motorway lessons, and Pass Plus available across all areas of York.",
      "telephone": "+447763999317",
      "email": "support@yorkdrivinglesson.co.uk",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Unit 2, Arabesque House, Monks Cross Drive",
        "addressLocality": "York",
        "addressRegion": "North Yorkshire",
        "postalCode": "YO32 9GW",
        "addressCountry": "GB"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 53.988,
        "longitude": -1.0647
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
          "opens": "00:00",
          "closes": "23:59"
        }
      ],
      "areaServed": {
        "@type": "City",
        "name": "York"
      },
      "priceRange": "££"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://yorkdrivinglesson.co.uk/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "About Us",
          "item": "https://yorkdrivinglesson.co.uk/about-us/"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is York Driving Lesson?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "York Driving Lesson helps learners find driving lesson support in York. We cover a wide range of services including automatic driving lessons, manual driving lessons, refresher lessons, intensive driving courses, motorway lessons, mock driving tests, and Pass Plus options."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer automatic driving lessons in York?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, automatic driving lessons are available for learners who prefer a simpler driving experience without the need to manage a clutch and gear stick. You can ask about availability and lesson options before getting started."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer manual driving lessons in York?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, manual driving lessons are available for those who want to learn full vehicle control, including clutch coordination and manual gear changes."
          }
        },
        {
          "@type": "Question",
          "name": "Can nervous learners enquire?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely. We understand that starting to drive can be daunting, so we focus on calm, steady, and structured lessons to help nervous learners build confidence at their own pace."
          }
        },
        {
          "@type": "Question",
          "name": "What areas of York do you cover?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We cover a wide range of areas in York and surrounding locations including Acomb, Clifton, Fulford, Heworth, Haxby, Tang Hall, Rawcliffe, Bishopthorpe, and many others."
          }
        },
        {
          "@type": "Question",
          "name": "Do you help beginners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we help complete beginners start from the very basics. Our aim is for you to feel comfortable and safe as you take your first steps onto York's roads."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer refresher lessons?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, refresher lessons are a great way for licence holders to rebuild their confidence after a break from driving or to get used to new road conditions."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer intensive driving courses?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, intensive driving courses may be an option for learners who want more focused lesson time over a shorter period, depending on instructor availability."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer mock driving tests?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, mock driving tests are designed to simulate real test conditions, helping you identify areas for improvement and reducing nerves for the actual day."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer motorway lessons?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, motorway lessons help qualified drivers or advanced learners build confidence with higher speeds, lane discipline, and the complexities of motorway junctions."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer Pass Plus?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, the Pass Plus course is available for new drivers who want to gain extra experience."
          }
        },
        {
          "@type": "Question",
          "name": "How do I enquire about lessons?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can enquire easily by calling us directly or by sending a message via WhatsApp. We're happy to discuss your goals and help you find the best next step."
          }
        },
        {
          "@type": "Question",
          "name": "Do you guarantee driving test passes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, we cannot guarantee a pass as it depends on your performance on the day. However, our structured lessons are designed to prepare you to be a safe, competent driver."
          }
        },
        {
          "@type": "Question",
          "name": "Can I ask which lesson type is right for me?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we are happy to discuss your goals and help you decide whether automatic driving lessons, manual driving lessons, refresher lessons, or intensive driving courses are the best fit for you."
          }
        }
      ]
    }
  ]
}
  </script>
</Layout>
