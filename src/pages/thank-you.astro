---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
---

<Layout
  title="Enquiry Received — Thank You"
  description="Thank you for your enquiry. York Driving Lesson will be in touch within 2 hours."
  noindex={true}
>
  <Header client:load />

  <main class="min-h-screen bg-soft-bg font-sans flex items-center justify-center px-6 py-32">
    <div class="max-w-[560px] w-full text-center">
      <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-8">
        <svg class="w-8 h-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="text-[2.4rem] sm:text-[3rem] font-black text-primary-text tracking-tighter uppercase leading-none mb-4">
        Enquiry Received
      </h1>
      <p class="text-[1.05rem] text-secondary-text font-medium leading-relaxed mb-10">
        Thanks for getting in touch. We'll get back to you within <strong class="text-primary-text">2 hours</strong> to discuss your driving lessons.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="bg-primary-dark text-white px-8 py-4 rounded-full text-[0.82rem] font-black uppercase tracking-widest no-underline hover:-translate-y-px hover:shadow-lg transition-all duration-200"
        >
          Back to Home
        </a>
        <a
          href="/articles/pass-driving-test-first-time-york"
          class="bg-white text-primary-text border border-border-main/20 px-8 py-4 rounded-full text-[0.82rem] font-black uppercase tracking-widest no-underline hover:-translate-y-px hover:shadow-md transition-all duration-200"
        >
          Read Our Guides
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
