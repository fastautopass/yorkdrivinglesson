    mockTestPoints={[
      "Examiner-style feedback on A1237 roundabout discipline",
      "Realistic assessment of Water End junction planning",
      "Focused Independent driving practice on local Clifton routes"
    ]}
    nearbyAreas={['Rawcliffe', 'Bootham', 'Haxby', 'Huntington', 'York City Centre', 'Heworth']}
    faqs={faqs}
