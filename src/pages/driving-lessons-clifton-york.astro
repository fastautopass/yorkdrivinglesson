---
import Layout from '../layouts/Layout.astro';
import LocationTemplate from '../components/PageTemplates/LocationTemplate';

const faqs = [
  { 
    question: "Do you pick up from Clifton Green for driving lessons?", 
    answer: "Yes, we can start your lessons from Clifton Green or any residential address in Clifton. It's a great starting point for practising junctions and lane positioning before heading towards Water End or the <a href='/monks-cross-driving-test-centre' class='font-bold underline'>Monks Cross Driving Test Centre</a>."
  },
  { 
    question: "How do you help beginners near Water End in York?", 
    answer: "Water End can be busy, so we usually start absolute beginners in the quieter residential pockets around Shipton Road. Once your car control is steady, we'll progress to the traffic flow and roundabouts in the Clifton area during your driving lessons in York."
  },
  { 
    question: "Are automatic driving lessons available in Clifton?", 
    answer: "We offer full <a href='/automatic-driving-lessons' class='font-bold underline'>automatic driving lessons in York</a> across Clifton. This is a popular choice for those who want to navigate York's busier junctions without the added complexity of a clutch pedal." 
  },
  {
    question: "Can I practise for the York driving test around Clifton?",
    answer: "While the test centre is in another part of the city, the road conditions in Clifton—including large roundabouts—are perfect for developing the observation and planning skills examiners look for during the <a href='/monks-cross-driving-test-centre' class='font-bold underline'>practical test</a>."
  },
  { 
    question: "Do you offer intensive courses for learners in Clifton?", 
    answer: "Yes, our <a href='/intensive-driving-courses' class='font-bold underline'>intensive driving courses in York</a> are available for Clifton residents. We adapt the schedule to help you reach test standard while keeping you safe and confident on York's diverse roads."
  },
  { 
    question: "What is the best area in Clifton for first-time learners?", 
    answer: "We often recommend the quieter streets off Shipton Road or residential areas near the library. These spots allow you to build clutch control and basic steering without the pressure of heavy commuter traffic starting your <a href='/manual-driving-lessons' class='font-bold underline'>manual driving lessons</a>."
  },
  {
    question: "Do you cover the YO30 area for driving tuition?",
    answer: "Absolutely. We provide driving tuition throughout the YO30 postcode, covering all of Clifton and surrounding neighbourhoods with our driving lessons in York."
  },
  { 
    question: "How do you handle nervous learners in busy junction areas?", 
    answer: "We use a step-by-step approach. We won't tackle the busier Clifton junctions until you feel ready. Our goal is to build your confidence gradually in a calm, supportive environment until you're ready for busier spots like <a href='/driving-lessons-acomb-york' class='font-bold underline'>Acomb</a> or the city centre." 
  },
  { 
    question: "Can I have lessons during the school run in Clifton?", 
    answer: "Yes, lessons during busy times are helpful for learning to anticipate other road users. We'll focus on your hazard perception and defensive driving skills to help you feel safe in all traffic conditions."
  },
  { 
    question: "Do you offer mock driving tests near Clifton?", 
    answer: "We provide <a href='/mock-driving-tests' class='font-bold underline'>mock driving tests in York</a> that simulate real exam conditions. We use local road layouts to test your independent driving and observation skills under realistic pressure." 
  },
  { 
    question: "Can I learn manual gear changes on the roads leading to Bootham?", 
    answer: "The roads towards <a href='/driving-lessons-bootham-york' class='font-bold underline'>Bootham</a> offer varied traffic conditions, making them excellent for practising smooth gear changes and hill starts in a real-world York environment."
  },
  { 
    question: "Is there availability for weekend lessons in Clifton?", 
    answer: "We aim to be flexible. Depending on our current schedule, we can often accommodate weekend or evening lessons for learners in the Clifton area who have busy weekday commitments." 
  },
  { 
    question: "How long are the driving lessons usually?", 
    answer: "Our standard lessons are typically 90 minutes or 2 hours. This provides enough time to practise local Clifton routes and venture into wider York traffic for a more varied experience."
  },
  {
    question: "Do you provide help with the theory test as well?",
    answer: "While our focus is on practical driving, we're always happy to offer advice on hazard perception and road signs during your lessons in Clifton to help prepare you for the theory exam."
  }
];

const practiceRoutesItems = [
