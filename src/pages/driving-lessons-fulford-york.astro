import Layout from '../layouts/Layout.astro';
import LocationTemplate from '../components/PageTemplates/LocationTemplate';

const faqs = [
  { 
    question: "Where do we start driving lessons in Fulford?", 
    answer: "We can start from your home in Fulford or a local spot like Main Street. Beginners often start in the quieter residential loops near Connaught Court to build basic car control before heading onto busier roads."
  },
  { 
    question: "How do you help learners with the traffic on Fulford Road?", 
    answer: "Fulford Road is a major route. We introduce it once your basics are strong, helping you manage commuter traffic and lane positioning near the city centre approaches and the <a href='/monks-cross-driving-test-centre/' class='font-bold underline'>Monks Cross Driving Test Centre</a>."
  },
  { 
    question: "Can we practise for the A64/A19 interchange in Fulford?",
    answer: "Absolutely. The approaches to the Designer Outlet and the A64 interchange are excellent for practising higher-speed merging and multi-lane roundabouts during your <a href='/manual-driving-lessons/' class='font-bold underline'>driving lessons in York</a>."
  },
  { 
    question: "Do you offer automatic driving lessons in YO10/YO19?", 
    answer: "Yes, we provide full <a href='/automatic-driving-lessons/' class='font-bold underline'>automatic driving lessons in York</a> throughout Fulford and the YO10/YO19 postcodes, which is great for navigating York's busier arterial roads without the gear stress." 
  },
  { 
    question: "Is Fulford a good area for absolute beginners?", 
    answer: "Yes, the residential streets off Main Street offer a calm environment for building clutch control and confidence at basic junctions. It's an ideal starting point for <a href='/manual-driving-lessons/' class='font-bold underline'>manual driving lessons</a>."
  },
  { 
    question: "How do you teach lane discipline near the Fulford Designer Outlet?", 
    answer: "The large roundabouts near the outlet are perfect for practising forward planning, mirror routines, and anticipating traffic flow from multiple directions."
  },
  { 
    question: "Do you offer intensive driving courses in Fulford?", 
    answer: "Yes, our <a href='/intensive-driving-courses/' class='font-bold underline'>intensive driving courses in York</a> are available for residents in Fulford. They are a focused way to build your driving skills quickly using local road layouts and common local routes." 
  },
  { 
    question: "Can I practise for my driving test on routes near Fulford?", 
    answer: "While we cover various parts of the city, the road conditions in Fulford—including high-speed exits—are essential for reaching the DVSA test standard required to pass."
  },
  {
    question: "Do you pick up from local offices or the University for lessons?",
    answer: "We're very flexible and can arrange pickups from your place of work, the University of York campus, or home in Fulford — including anywhere along Fulford Road or the A19 — so your lessons fit into your day."
  },
  {
    question: "Are evening or weekend driving lessons available in Fulford?",
    answer: "We aim to be flexible. Depending on current instructor availability, evening or weekend lessons can be arranged so you can experience driving in different lighting conditions on Fulford Road and the A19 during peak commuter hours."
  },
  { 
    question: "How do you handle the narrow sections of Fulford Main Street?", 
    answer: "The village section of Fulford can be tight. We'll practise observation and priority correctly in these 'meeting' situations to help you develop strong hazard perception skills."
  },
  {
    question: "Do we learn to use a sat-nav during our lessons?",
    answer: "Yes, once you're steady with basic car control, we incorporate sat-nav training. It's a key part of the modern test and vital for building true independent driving on Fulford Road, the A19, and the A64 interchange approaches."
  },
  { 
    question: "What if I'm particularly nervous about driving towards the A64?", 
    answer: "Our instructors are known for their patient approach. We'll progress at your pace, staying on quieter Fulford roads until you're truly ready for the busier junctions near <a href='/driving-lessons-heslington-york/' class='font-bold underline'>Heslington</a>." 
  },
  {
    question: "How can I book an assessment lesson in Fulford?",
    answer: "Simply fill out our online enquiry form. We’ll discuss your goals and match you with a local instructor covering Fulford Road, the A19, and the surrounding YO10 area."
  }
];

const practiceRoutesItems = [
