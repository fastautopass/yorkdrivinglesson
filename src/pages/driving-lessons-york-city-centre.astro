---
import Layout from '../layouts/Layout.astro';
import LocationTemplate from '../components/PageTemplates/LocationTemplate';

const faqs = [
  { 
    question: "Where do we start driving lessons in York City Centre?", 
    answer: "We can start from a convenient local spot like near the station or a multi-storey car park entrance. Beginners often start in the quieter residential loops on the outskirts to build basic confidence during your driving lessons in York."
  },
  { 
    question: "How do you help learners with the inner ring road?", 
    answer: "The York inner ring road (A1036) is busy. We introduce it once your car control is solid, helping you manage lane planning and multi-lane roundabout priority near the <a href='/monks-cross-driving-test-centre' class='font-bold underline'>Monks Cross Driving Test Centre</a>."
  },
  { 
    question: "Can we practise for the junctions near the city walls?",
    answer: "Yes, the junctions near the walls and bridges like Lendal are excellent for practising lane discipline, mirror routines, and anticipating varied urban traffic flow."
  },
  { 
    question: "Do you offer automatic driving lessons in the city centre?", 
    answer: "Absolutely. We provide <a href='/automatic-driving-lessons' class='font-bold underline'>automatic driving lessons in York</a> throughout York City Centre, which is ideal for navigating the busy urban traffic."
  },
  { 
    question: "Is York City Centre a good place for absolute beginners?", 
    answer: "While the central routes are busy, the residential streets just outside the inner ring road offer a calm environment for getting comfortable with the basics. It's an ideal spot for starting <a href='/manual-driving-lessons' class='font-bold underline'>manual driving lessons</a>." 
  },
  { 
    question: "How do you teach lane discipline on the busy Lendal Bridge approaches?", 
    answer: "Approaches to York's bridges are excellent for practising lane planning and mirror routines. We focus on helping you anticipate varied traffic near <a href='/driving-lessons-bootham-york' class='font-bold underline'>Bootham</a>."
  },
  { 
    question: "Do you offer intensive driving courses in York City Centre?", 
    answer: "Yes, our <a href='/intensive-driving-courses' class='font-bold underline'>intensive driving courses in York</a> are available for residents in and around the city centre. They are a focused way to build your skills quickly using local urban road layouts and York routes." 
  },
  { 
    question: "Can I practise for my driving test on city centre routes?",
    answer: "While we cover various parts of the city, the road conditions in the centre are essential for reaching the DVSA test standard at the <a href='/monks-cross-driving-test-centre' class='font-bold underline'>practical test</a>. We also cover bus lane entry points and one-way system planning, which are common observations on York city centre routes." 
  },
  { 
    question: "Do you pick up from the York Railway Station area?", 
    answer: "We're very flexible and can arrange pickups from your home in York city centre — including near the railway station, Fishergate, or the inner ring road — so your lessons fit into your day."
  },
  { 
    question: "Are evening or weekend driving lessons available in the city?", 
    answer: "We aim to be flexible. Depending on current instructor availability, evening or weekend lessons can be arranged so you can experience driving in different lighting conditions on Fishergate, Gillygate, and the inner ring road."
  },
  { 
    question: "How do you handle the high cyclist and pedestrian activity in the centre?", 
    answer: "The city centre is busy with tourists and cyclists. We'll practise keen observation and safe passing distances to help you develop strong hazard perception."
  },
  { 
    question: "Do we learn to use a sat-nav during our lessons?", 
    answer: "Yes, once you're steady with basic car control, we incorporate sat-nav training. It's a key part of the modern test and vital for building true independent driving on the A1036, the inner ring road, and navigating the one-way systems around York city centre."
  },
  { 
    question: "What if I'm particularly nervous about driving in dense urban traffic?", 
    answer: "Our instructors are known for their patient approach. We'll progress at your pace, staying on quieter routes until you're truly ready for the busier inner ring road junctions." 
  },
  { 
    question: "How can I book an assessment lesson in York City Centre?", 
    answer: "Simply fill out our online enquiry form. We’ll discuss your goals and current level of experience to match you with a local instructor covering the inner ring road, Lendal Bridge, and the surrounding YO1 area."
  }
];

const practiceRoutesItems = [
  {
    icon: 'Navigation',
    title: 'Inner Ring Road Loop',
    description: 'Build lane choice confidence and mirror routines on the busiest multi-lane stretches of the A1036 that circle the city walls.'
  },
  {
    icon: 'MapPinned',
    title: 'Bridge & Gate Approaches',
    description: 'A great way to develop your junction timing and lane planning as you head across the Ouse towards the historic city gates.'
  },
  {
    icon: 'School',
    title: 'Station & Quarter Routes',
    description: 'Practise your hazard perception in high-activity areas where buses, taxis, and pedestrians are constant through the working day.'
  }
];

const roadsJunctionsItems = [
  {
    icon: 'Map',
    title: 'Multi-Lane Planning',
    description: 'Focused practice on the busy junctions connecting the inner ring road, focusing on lane selection, observation, and confident priority.',
    badge: 'Urban Planning'
  },
  {
    icon: 'Navigation',
    title: 'High-Density Observation',
    description: 'Developing sharp observation near local landmarks where traffic flow can be dense and unpredictable during peak times.',
    badge: 'Sharp Observation'
  },
  {
    icon: 'Clock',
    title: 'Complex Route Anticipation',
    description: 'Learning to stay calm and anticipatory during peak traffic times on the main routes connecting the various quarters of York City Centre.',
    badge: 'Calm Observation'
  }
];
