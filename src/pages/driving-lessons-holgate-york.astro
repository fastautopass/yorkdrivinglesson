---
import Layout from '../layouts/Layout.astro';
import LocationTemplate from '../components/PageTemplates/LocationTemplate';

const faqs = [
  { 
    question: "Where do we start driving lessons in Holgate?", 
    answer: "We can start from your home in the Holgate area or a nearby landmark like the local station. Beginners often start in the quieter residential grids off Hamilton Drive to build confidence with car control before heading into urban flow."
  },
  { 
    question: "How do you help with the busy traffic on Holgate Road?", 
    answer: "Holgate Road (A59) is a key route. We'll introduce this only when your basics are strong, helping you manage commuter traffic and lane positioning near the ironworks and the <a href='/monks-cross-driving-test-centre' class='font-bold underline'>Monks Cross Driving Test Centre</a>."
  },
  { 
    question: "Can we practise hill starts near the Holgate Windmill?", 
    answer: "The inclines around the windmill are ideal for building confidence with hill starts and finding your clutch bite point during your <a href='/manual-driving-lessons' class='font-bold underline'>driving lessons in York</a>."
  },
  { 
    question: "Do you offer automatic driving lessons in YO24?", 
    answer: "Yes, we provide full coverage for <a href='/automatic-driving-lessons' class='font-bold underline'>automatic driving lessons in York</a> in Holgate and YO24, which is great for navigating York's busier urban junctions without the stress of gear changes." 
  },
  { 
    question: "Is Holgate a good area for absolute beginners?", 
    answer: "Definitely. The residential streets around Hamilton Drive offer manageable road layouts that help you build confidence before starting <a href='/manual-driving-lessons' class='font-bold underline'>manual driving lessons</a> in busier traffic." 
  },
  { 
    question: "How do you teach lane discipline near the York station area?", 
    answer: "The station approaches can be complex. We'll practise lane planning and observation early so you feel calm when navigating towards the busier city centre and the York inner ring road."
  },
  { 
    question: "Do you offer intensive driving courses in Holgate?", 
    answer: "Yes, our <a href='/intensive-driving-courses' class='font-bold underline'>intensive driving courses in York</a> are available for residents in Holgate. We use the local road network to provide a concentrated learning experience built around York's road systems." 
  },
  { 
    question: "Can I practise for the York driving test on Holgate routes?", 
    answer: "While you'll practise on varied test routes, the road conditions in Holgate—including junction priority—are excellent for reaching the DVSA test standard expected to pass."
  },
  { 
    question: "Do you pick up from local offices or schools in Holgate?", 
    answer: "We're very flexible and can arrange pickups from your workplace, local school, or home in Holgate — including near Holgate Road or the Windmill area — so your lessons fit into your day." 
  },
  { 
    question: "Are evening lessons available for Holgate learners?", 
    answer: "We aim to offer flexible hours. Depending on current availability, evening or weekend lessons can be arranged so you can experience driving in different lighting conditions on Holgate Road and the A59 near York railway station." 
  },
  { 
    question: "How do you handle the mini-roundabouts near Hamilton Drive?", 
    answer: "Mini-roundabouts are a key part of driving. We'll practise observation and priority at specific Holgate roundabouts until you can navigate them instinctively and safely."
  },
  { 
    question: "Do we learn how to use a sat-nav during lessons?", 
    answer: "Yes, once you're confident with basic car control, we incorporate sat-nav training. This is a vital skill for the <a href='/monks-cross-driving-test-centre' class='font-bold underline'>Monks Cross Driving Test Centre</a> and for building true independent driving along Holgate Road, the A59, and the York station approach junctions."
  },
  { 
    question: "What if I'm particularly nervous about driving in traffic?", 
    answer: "Our instructors are known for their patient approach. We will progress at a pace that is comfortable for you, staying in quieter parts of Holgate until you're ready for busier spots like <a href='/driving-lessons-acomb-york' class='font-bold underline'>Acomb</a>." 
  },
  { 
    question: "How can I book an assessment lesson in Holgate?", 
    answer: "Simply fill out our online enquiry form. We’ll discuss your goals and match you with a local instructor covering Holgate Road, Hamilton Drive, and the surrounding YO24 area." 
  }
];

