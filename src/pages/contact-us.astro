---
import Layout from '../layouts/Layout.astro';
import ContactUs from '../components/pages/ContactUs';
---

<Layout
  title="Contact York Driving Lesson | Book Your First Lesson"
  description="Get in touch with York Driving Lesson. Call, WhatsApp, or email to book manual, automatic, intensive, or refresher driving lessons across York. Enquire now."
>
  <ContactUs client:load />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "DrivingSchool",
      "name": "York Driving Lesson",
      "url": "https://yorkdrivinglesson.co.uk",
      "image": "https://yorkdrivinglesson.co.uk/images/logo.png",
      "description": "DVSA-approved driving school covering all areas of York. Manual, automatic, intensive, refresher, mock tests, motorway, and Pass Plus lessons available.",
      "telephone": "+447763999317",
      "email": "support@yorkdrivinglesson.co.uk",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Unit 2, Arabesque House, Monks Cross Drive",
        "addressLocality": "York",
        "addressRegion": "North Yorkshire",
        "postalCode": "YO32 9GW",
        "addressCountry": "GB"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 53.988,
        "longitude": -1.0647
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
          "opens": "00:00",
          "closes": "23:59"
        }
      ],
      "areaServed": {
        "@type": "City",
        "name": "York"
      },
      "priceRange": "££"
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://yorkdrivinglesson.co.uk/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Contact Us",
          "item": "https://yorkdrivinglesson.co.uk/contact-us/"
        }
      ]
    }
  </script>
</Layout>
