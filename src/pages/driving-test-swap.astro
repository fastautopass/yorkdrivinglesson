---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import TestSwapFAQ from '../components/pages/TestSwapFAQ';
---

<Layout
  title="Swap Your Driving Test Slot in York | Find Cancellations"
  description="Need an earlier driving test date in York? TestSwap lets learners swap DVSA test slots directly with other learners under the new rules. Check now."
>
  <Header client:visible />

  <main class="pt-28 font-sans bg-soft-bg">

    {/* HERO */}
    <section class="px-6 sm:px-10 pb-16">
      <div class="max-w-[1280px] mx-auto">
        <div class="mb-3">
          <span class="text-[0.7rem] font-black uppercase tracking-[0.2em] text-primary-dark/60">Learner Resource</span>
        </div>
        <h1 class="text-[2.8rem] sm:text-[4rem] font-black text-primary-text mb-4 leading-none tracking-tighter uppercase">
          Swap Your Driving Test Slot in York
        </h1>
        <p class="text-[1.1rem] sm:text-[1.2rem] text-secondary-text leading-relaxed font-medium opacity-80">
          Can't wait months for a test date at Monks Cross? TestSwap lets you exchange your DVSA test slot directly with another learner — legally, under the new DVSA rules, and completely free.
        </p>
      </div>
    </section>

    {/* MAIN CARD */}
    <section class="px-6 sm:px-10 pb-20">
      <div class="max-w-[1280px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8">

        {/* What is TestSwap */}
        <div class="bg-white rounded-[32px] p-10 border border-border-main/10 shadow-sm flex flex-col">
          <div class="w-12 h-1.5 bg-primary-dark/10 mb-6"></div>
          <h2 class="text-[1.8rem] font-black text-primary-text uppercase tracking-tight leading-tight mb-4">
            What is TestSwap?
          </h2>
          <p class="text-secondary-text text-[0.95rem] leading-relaxed font-bold opacity-70 mb-4">
            TestSwap is a free platform where learner drivers swap their DVSA practical test slots directly with each other. If your test date no longer suits you — or you want an earlier slot — you can find another learner who wants yours and take theirs instead.
          </p>
          <ul class="flex flex-col gap-2 mb-8">
            {[
              'Learner-to-learner swaps — no third party involved',
              'Completely free to use',
              'Approved under new DVSA rules',
              'Find earlier test dates in York',
              'No slot scalping — no inflated prices',
            ].map((point) => (
              <li class="flex items-start gap-3 text-[0.9rem] text-secondary-text font-bold opacity-80">
                <span class="text-primary-dark font-black mt-0.5">✓</span>
                {point}
              </li>
            ))}
          </ul>
          <div class="mt-auto">
            <a
              href="https://www.testswap.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 bg-primary-dark text-white py-4 px-8 rounded-xl text-[0.8rem] font-black uppercase tracking-widest no-underline hover:bg-secondary-dark transition-colors w-full"
            >
              Visit TestSwap →
            </a>
          </div>
        </div>

        {/* How it works */}
        <div class="bg-primary-dark rounded-[32px] p-10 flex flex-col">
          <div class="w-12 h-1.5 bg-white/10 mb-6"></div>
          <h2 class="text-[1.8rem] font-black text-white uppercase tracking-tight leading-tight mb-4">
            How It Works
          </h2>
          <p class="text-white/70 text-[0.95rem] leading-relaxed font-bold mb-6">
            The swap happens through the official DVSA booking system. TestSwap simply helps you find the right match.
          </p>
          <ol class="flex flex-col gap-4 mb-8">
            {[
              { step: '1', text: 'Create a free account on TestSwap and list your current test slot' },
              { step: '2', text: 'Browse slots listed by other learners in York and nearby areas' },
              { step: '3', text: 'Find a mutual match — both learners agree to the swap' },
              { step: '4', text: 'Both learners rebook simultaneously through the official DVSA website' },
              { step: '5', text: 'Tell your instructor your new test date and prepare accordingly' },
            ].map((item) => (
              <li class="flex items-start gap-4 text-[0.9rem] text-white/70 font-bold">
                <span class="w-7 h-7 rounded-full bg-white/10 text-white font-black text-[0.75rem] flex items-center justify-center shrink-0">{item.step}</span>
                {item.text}
              </li>
            ))}
          </ol>
          <div class="mt-auto">
            <a
              href="https://www.testswap.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 bg-white text-primary-dark py-4 px-8 rounded-xl text-[0.8rem] font-black uppercase tracking-widest no-underline hover:bg-soft-bg transition-colors w-full"
            >
              Find a Swap →
            </a>
          </div>
        </div>

      </div>
    </section>

    {/* DVSA NOTICE */}
    <section class="px-6 sm:px-10 pb-16">
      <div class="max-w-[1280px] mx-auto">
        <div class="bg-white rounded-[24px] p-8 border border-border-main/10 flex flex-col sm:flex-row gap-6 items-start">
          <div class="text-[2rem] shrink-0">⚠️</div>
          <div>
            <h3 class="text-[1rem] font-black text-primary-text uppercase tracking-tight mb-2">Important — Tell Your Instructor First</h3>
            <p class="text-secondary-text text-[0.9rem] font-bold opacity-70 leading-relaxed">
              If you swap to an earlier test date, let your instructor know immediately. Swapping to a slot you're not ready for can lead to an unnecessary fail. Your instructor will tell you honestly whether you're at test standard — always check before committing to a new date.
            </p>
          </div>
        </div>
      </div>
    </section>

    <TestSwapFAQ client:visible />

  </main>

  <Footer />




</Layout>
